# LLM Provider (choose one or both)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Which provider to use: "openai" | "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Judge model for evals
JUDGE_MODEL=gpt-4o

# App settings
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: persist conversations
SQLITE_PATH=./data/conversations.db
